# App
PORT=3000
NODE_ENV=development

# 외부에 공개되는 서비스 주소.
# 카카오 서버가 카드뉴스 이미지를 직접 불러가므로 실제 발송 시에는
# 반드시 외부에서 접근 가능한 주소여야 한다. (미설정 시 http://localhost:{PORT})
BASE_URL=

# 네이버 뉴스 검색 API (https://developers.naver.com)
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret
# 카테고리당 수집할 뉴스 수
NEWS_PER_CATEGORY=3

# Groq API (카드뉴스 문구 생성)
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# 카드뉴스 이미지 생성 제공자 (huggingface | pollinations)
#
# huggingface : 빠르고(9건 약 20초) 안정적이며 품질이 좋다. (권장)
#               이미지를 직접 호스팅하므로 카카오 메시지에 이미지를 넣으려면
#               BASE_URL 이 외부에서 접근 가능한 주소여야 한다.
# pollinations: API 키가 필요 없고 공개 이미지 URL 을 주므로 BASE_URL 없이도
#               카카오에 이미지가 들어간다. 다만 무료 서비스라 429/500 이 잦고
#               생성이 느리다. HF 크레딧이 없을 때의 대안으로 쓴다.
IMAGE_PROVIDER=huggingface

# HuggingFace Inference Providers
HF_TOKEN=your_huggingface_token
# 사용 가능한 provider: nscale, together, wavespeed
HF_IMAGE_PROVIDER=nscale
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# Pollinations
POLLINATIONS_IMAGE_SIZE=1024
# true 면 pollinations 공개 이미지 URL 을 그대로 사용한다.
# false 면 이미지를 내려받아 public/images 에 저장하고 BASE_URL 로 서빙한다.
POLLINATIONS_DIRECT_URL=true
# 재시도 백오프 기준 간격(ms). 기본 4000 → 4s, 8s, 16s 로 늘어난다.
POLLINATIONS_RETRY_DELAY_MS=4000

# 카드뉴스 생성 동시 실행 수 (외부 API rate limit 대응)
# pollinations 는 무료 티어 rate limit 이 빡빡해 1 을 권장한다.
CARD_NEWS_CONCURRENCY=3

# 생성된 이미지 보관 일수
IMAGE_RETENTION_DAYS=7

# 카카오톡 (https://developers.kakao.com)
KAKAO_REST_API_KEY=your_kakao_rest_api_key
# 보안 설정에서 client secret 을 활성화한 경우에만 입력
KAKAO_CLIENT_SECRET=
# OAuth 동의 절차로 직접 발급받아야 함 (README '카카오 토큰 발급' 참고)
KAKAO_REFRESH_TOKEN=your_kakao_refresh_token

# 카카오 메시지 연속 발송 간격(ms)
KAKAO_SEND_INTERVAL_MS=300

# 스케줄러
NOTIFICATION_CRON=0 8 * * *
SCHEDULER_TIMEZONE=Asia/Seoul
# POST /scheduler/run 수동 실행 보호용 토큰 (운영 환경에서는 필수)
SCHEDULER_TRIGGER_TOKEN=
